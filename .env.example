NODE_ENV=development
PORT=5000

# Pooled connection (via PgBouncer / -pooler host) — used by the app at runtime
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.c-1.region.aws.neon.tech/civicdesk?sslmode=require&channel_binding=require
# Direct connection (no -pooler in hostname) — used only for `prisma migrate`
DIRECT_URL=postgresql://user:password@ep-xxx.c-1.region.aws.neon.tech/civicdesk?sslmode=require&channel_binding=require

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — caching for GET /departments and GET /service-types. Leave blank to disable.
REDIS_URL=

SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_LIVE=false

CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

ADMIN_PASSWORD=change_me_admin_password
